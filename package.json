{
  "name": "home-aid-intake-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:reset": "prisma db push --force-reset --skip-generate",
    "db:seed": "vite-node prisma/seed.ts",
    "setup": "prisma generate && prisma db push --skip-generate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "prisma": {
    "seed": "vite-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.22",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "vite-node": "2.1.9",
    "vitest": "2.1.9"
  }
}
